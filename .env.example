# Copy this file to .env at the repo root and fill in your values.
# The pipeline auto-loads .env via pipeline.common.env at CLI startup.
# Values already exported in the shell win over what's here.

# Anthropic API key — required when llm.mode = "record" in repoeval.toml.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional overrides (dotted keys map to repoeval.toml)
# REPOEVAL_LLM_MODEL=claude-sonnet-5
# REPOEVAL_LLM_TEMPERATURE=0.0
